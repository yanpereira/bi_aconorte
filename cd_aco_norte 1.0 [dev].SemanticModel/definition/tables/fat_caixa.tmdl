	column Venda_ID = ```
			
			VAR Texto = 'fat_caixa'[historico]
			VAR NumeroExtraido = 
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            GENERATESERIES(1, LEN(Texto)),
			            "Letra", MID(Texto, [Value], 1)
			        ),
			        "Digito", [Letra]
			    )
			VAR SomenteNumeros = 
			    CONCATENATEX(
			        FILTER(NumeroExtraido, [Digito] >= "0" && [Digito] <= "9"),
			        [Digito],
			        ""
			    )
			RETURN 
			    IF(SomenteNumeros <> "", VALUE(SomenteNumeros), BLANK())
			```
		dataType: int64
		formatString: 0
		lineageTag: abf4c58b-d4a4-4f5a-a780-eede5bf848f6
		summarizeBy: count

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column id_pessoa =
			
			fat_caixa[cd_pessoa]&
			fat_caixa[ds_sistema]
		lineageTag: bb45225f-06d0-4310-b137-45fbe4170e70
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column valor
		dataType: double
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 073b2f45-40aa-47d6-b39e-685a16e2d341
		summarizeBy: sum
		sourceColumn: valor

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column dias_atraso =
			
			IF(
			    NOT ISBLANK(fat_caixa[dtVencimento]) && fat_caixa[dtVencimento] < TODAY(),
			    DATEDIFF(fat_caixa[dtVencimento], TODAY(), DAY),
			    0
			)
		formatString: 0
		lineageTag: 0ed07296-86d5-491a-aacc-ef9fd0c902c9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column VendaID = ```
			
			VAR Texto = 'fat_caixa'[historico]
			VAR PosicaoEspaco = FIND(" ", Texto, 1, -1)
			VAR Resultado = 
			    IF(
			        PosicaoEspaco > 0,
			        MID(Texto, PosicaoEspaco + 1, LEN(Texto) - PosicaoEspaco),
			        BLANK()
			    )
			RETURN Resultado
			```
		lineageTag: 5f01cc08-2fcd-410a-92bb-268d472fd67e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

