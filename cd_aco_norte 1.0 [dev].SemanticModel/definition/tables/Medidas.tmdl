	measure ultimo_preco =
			
			VAR UltimaData = MAX('Produtos Convert'[dt_pedido])
			RETURN
			CALCULATE(
			    MAX('Produtos Convert'[CustoUnitário]),
			    'Produtos Convert'[dt_pedido] = UltimaData
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 5. Preços
		lineageTag: dc1fa2cd-33f6-49f6-8a71-b5b1350d08bb

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure vlr_estoque_final_compra =
			
			VAR DataFim = EOMONTH(MAX(dim_calendario[Data]), 0)
			
			VAR EstoqueAtualCompra =
			    CALCULATE(
			        SUMX(
			            FILTER(fat_estoques, fat_estoques[estoque] > 0),
			            fat_estoques[estoque] * fat_estoques[preco_compra]
			        ),
			        ALL(dim_calendario)
			    )
			
			-- entradas após DataFim: valor real da NF (vlr_total)
			VAR EntradasApos =
			    CALCULATE(
			        SUM(fat_movimento[vlr_total]),
			        ALL(dim_calendario),
			        fat_movimento[tipo_movimento] = "E",
			        fat_movimento[stMov] = "E",
			        fat_movimento[dt_movimento] > DataFim
			    )
			
			-- saídas após DataFim: qtd × preço de compra atual
			VAR SaidasApos =
			    CALCULATE(
			        SUMX(
			            fat_movimento,
			            fat_movimento[qtd_movimento] * RELATED(dim_produtos[preco_compra])
			        ),
			        ALL(dim_calendario),
			        fat_movimento[tipo_movimento] = "S",
			        fat_movimento[stMov] = "E",
			        fat_movimento[dt_movimento] > DataFim
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(EstoqueAtualCompra),
			    EstoqueAtualCompra - EntradasApos + SaidasApos
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. CMV
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567801

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure vlr_estoque_inicial_compra =
			
			CALCULATE(
			    [vlr_estoque_final_compra],
			    PREVIOUSMONTH(dim_calendario[Data])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. CMV
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567802

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure vlr_compras_mes =
			
			VAR DataInicio = MIN(dim_calendario[Data])
			VAR DataFim    = MAX(dim_calendario[Data])
			RETURN
			CALCULATE(
			    SUM(fat_movimento[vlr_total]),
			    ALL(dim_calendario),
			    fat_movimento[tipo_movimento] = "E",
			    fat_movimento[stMov] = "E",
			    fat_movimento[dt_movimento] >= DataInicio,
			    fat_movimento[dt_movimento] <= DataFim
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. CMV
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567803

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure cmv_compra =
			
			VAR EI = [vlr_estoque_inicial_compra]
			VAR C  = [vlr_compras_mes]
			VAR EF = [vlr_estoque_final_compra]
			RETURN
			IF(
			    NOT ISBLANK(EI) || NOT ISBLANK(C),
			    EI + C - EF
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. CMV
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567804

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure vlr_estoque_final_venda =
			
			VAR DataFim = EOMONTH(MAX(dim_calendario[Data]), 0)
			
			VAR EstoqueAtualVenda =
			    CALCULATE(
			        SUMX(
