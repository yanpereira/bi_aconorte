	measure qtd_meses_capacidade_estoque =
			
			DIVIDE(
			    ([saldo_estoque_all] + [qtd_pedidos_comprados]),
			    [qtd_venda_media],0)
		displayFolder: 2.Movimentações
		lineageTag: e4116f3d-62c7-41f7-8058-7df74eecae24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure situacao_abastecer_estoque =
			
			SWITCH(
			    TRUE() ,
			    [qtd_meses_capacidade_estoque] > 0 &&
			    [qtd_meses_capacidade_estoque] < 2 &&
			    [qtd_venda_media] <> BLANK() &&
			    [qtd_pedidos_comprados] = 0,
			    "Comprar urgentemente" ,
			    [qtd_meses_capacidade_estoque] >= 2 &&
			    [qtd_venda_media] <> BLANK() &&
			    [qtd_pedidos_comprados] = 0,
			    "Comprar quando possível" ,
			    [qtd_meses_capacidade_estoque] < 0 &&
			    [qtd_venda_media] <> BLANK() ,
			    "Verificar real situação" ,
			    [qtd_meses_capacidade_estoque] > 0 &&
			    [qtd_meses_capacidade_estoque] < 2 &&
			    [qtd_venda_media] <> BLANK() &&
			    [qtd_pedidos_comprados] > 0,
			    "Aguardando recebimento" ,
			    [qtd_meses_capacidade_estoque] >= 2 &&
			    [qtd_venda_media] <> BLANK() &&
			    [qtd_pedidos_comprados] > 0,
			    "Aguardando recebimento")
		displayFolder: 2.Movimentações
		lineageTag: f276b488-8384-44b4-a5fa-8ea2c6954e50

