	measure dt_primeira_entrada =
			
			CALCULATE(
			    MIN(
			        fat_movimento[dt_movimento]) ,
			    ALL(
			        dim_calendario) ,
			    FILTER(
			        fat_movimento ,
			        fat_movimento[tipo_movimento] = "E" &&
			        fat_movimento[stMov] = "E"))
		formatString: Short Date
		displayFolder: 2.Movimentações
		lineageTag: 38408fc6-5c72-49a3-8623-75f53166f8d6

	measure dt_ultima_saida =
			
			CALCULATE(
			    MAX(
			        fat_movimento[dt_movimento]) ,
			    ALL(
			        dim_calendario) ,
			    FILTER(
			        fat_movimento ,
			        fat_movimento[tipo_movimento] = "S" &&
			        fat_movimento[stMov] = "E") ,
			    ALL(
			        fat_movimento) ,
			    VALUES(
			        dim_produtos[cd_produto]))
		formatString: Short Date
		displayFolder: 2.Movimentações
		lineageTag: e1740f0b-de03-45f9-af57-1342a25a2b5b

	measure qtd_dias_sem_venda =
			
			DATEDIFF(
