			    [qtd_vendas] ,
			    FILTER(
			        ALL(
			            dim_calendario) ,
			        dim_calendario[Últimos Dias] >= 0 &&
			        dim_calendario[Últimos Dias] <= SELECTEDVALUE(par_dias_vendas[par_dias_vendas])))
