	measure vlr_peso =
			
			SUMX(
			    SUMMARIZE(
			        dim_produtos ,
			        dim_produtos[cd_produto] ,
			        dim_produtos[ds_produto] ,
			        dim_produtos[id_produto] ,
			        dim_produtos[peso_bruto]) ,
			    dim_produtos[peso_bruto])
		formatString: #,0.00
		displayFolder: 2.Movimentações
		lineageTag: 82a33968-cc59-47ff-b0bc-2a0e411cc007

	measure vlr_peso_compra =
			
			IF(
			    [vlr_peso] = 0 ,
			    [qtd_comprar_simulacao] ,
			    ([qtd_comprar_simulacao] * [vlr_peso]))
		formatString: #,0.00
