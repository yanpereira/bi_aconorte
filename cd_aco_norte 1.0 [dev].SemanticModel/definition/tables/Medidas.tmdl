			        ),
			        ALL(dim_calendario),
			        fat_movimento[tipo_movimento] = "E",
			        fat_movimento[stMov] = "E",
			        fat_movimento[dt_movimento] > DataFim
			    )
			
			-- saídas após DataFim: qtd × preço de venda atual
			VAR SaidasApos =
			    CALCULATE(
			        SUMX(
			            fat_movimento,
			            fat_movimento[qtd_movimento] * RELATED(dim_produtos[preco_venda])
			        ),
			        ALL(dim_calendario),
			        fat_movimento[tipo_movimento] = "S",
			        fat_movimento[stMov] = "E",
			        fat_movimento[dt_movimento] > DataFim
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(EstoqueAtualVenda),
			    EstoqueAtualVenda - EntradasApos + SaidasApos
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. CMV
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567805

