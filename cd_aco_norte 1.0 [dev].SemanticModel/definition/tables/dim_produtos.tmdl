	column id_produto
		dataType: string
		lineageTag: 8da4d10f-2555-4347-9b1e-67af511b1723
		summarizeBy: none
		sourceColumn: id_produto

		annotation SummarizationSetBy = Automatic

	column dt_ultima_entrada =
			
			MAXX(
			    FILTER(
			        fat_movimento ,
			        fat_movimento[id_produto] = dim_produtos[id_produto] &&
			        fat_movimento[tipo_movimento] = "E" &&
			        fat_movimento[stMov] = "E" &&
			        fat_movimento[finNFe] <> 4) ,
			    fat_movimento[dt_movimento])
		formatString: Short Date
		lineageTag: afc06a20-a03d-48eb-af87-d3c8fc6b6d04
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 8d1ab68c-86a9-43ef-bd22-8a806f48e913
			defaultHierarchy: LocalDateTable_f0527294-4761-4457-a512-60eb1aa827c5.'Hierarquia de datas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column dt_ultima_venda =
			
			MAXX(
			    FILTER(
			        fat_vendas ,
			        fat_vendas[id_produto] = dim_produtos[id_produto]) ,
			    fat_vendas[dt_venda])
		formatString: Short Date
		lineageTag: 170dfab1-ed89-4a4e-a3f9-eabee7ce049f
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 52985eea-18bc-446d-b113-c62f874361a9
			defaultHierarchy: LocalDateTable_c7c1506d-3c02-4d56-9bb3-2827af3d5ca9.'Hierarquia de datas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

