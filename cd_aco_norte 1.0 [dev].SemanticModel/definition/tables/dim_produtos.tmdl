	column prod = dim_produtos[cd_produto] &" - "&dim_produtos[ds_produto]
		lineageTag: f41eb753-1e31-464b-99cc-092959fc5a02
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Qtd de Ocorrências' =
			
			CALCULATE(
			    COUNTROWS(dim_produtos),
			    ALLEXCEPT(dim_produtos, dim_produtos[cd_produto])
			)
		formatString: 0
		lineageTag: 3affa4a4-e93c-4de5-b52a-3ef9471197a5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Qtd ds_produto diferentes' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_produtos[ds_produto]),
			    ALLEXCEPT(dim_produtos, dim_produtos[cd_produto])
			)
		formatString: 0
		lineageTag: d1e43bc6-fa9d-4448-8a6a-3d3b35e93b70
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

