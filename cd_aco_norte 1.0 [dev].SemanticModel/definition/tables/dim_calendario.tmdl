	partition dim_calendario-ca82f879-aeac-4f03-a8ba-3c6339382f90 = calculated
		mode: import
		source =
				
				var datainicio =
				MIN(
				    fat_vendas[dt_venda])
				
				var datafim =
				MAX(
				    fat_vendas[dt_venda])
				
				var datas =
				CALENDAR(
				    DATE(
				        YEAR(
				            datainicio) ,
				        1 , 1) ,
				    DATE(
				        YEAR(
				            datafim) ,
				        12 , 31))
				return
				ADDCOLUMNS(
				    datas ,
				    "Dia" , DAY([Date]) ,
				    "Mês" , FORMAT([Date] , "mmmm") ,
				    "Mês Abrev" , FORMAT([Date] , "mmm") ,
				    "Nº Mês" , MONTH([Date]) ,
				    "Ano" , YEAR([Date]) ,
				    "Dia Semana" , FORMAT([Date] , "dddd") ,
				    "Nº Dia Semana" , WEEKDAY([Date] , 1) ,
				    "Anomes" , FORMAT([Date] , "yyyymm") ,
				    "Mês/Ano" , FORMAT([Date] , "mmm/yy") ,
				    "Últimos Meses" , DATEDIFF([Date] , TODAY() , MONTH) ,
				    "Últimos Dias" , DATEDIFF([Date] , TODAY() , DAY) ,
				    "Semana Mês" ,
				    WEEKNUM([Date]) -
				    WEEKNUM(
				        DATE(
				            YEAR(
				                [Date]) ,
				            MONTH(
				                [Date]) , 1)) + 1 ,
				    "Semana Ano" ,
				    WEEKNUM(
				        [Date]) ,
				    "Dia ùtil" ,
				    IF(
				        WEEKDAY([Date] , 1) > 1 &&
				        WEEKDAY([Date] , 1) < 7 ,
				        "S" , "N"))

	annotation PBI_Id = da57c67c691040f5bce23f71ba64e8d7

