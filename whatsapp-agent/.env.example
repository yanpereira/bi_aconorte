# ── Azure AD (Service Principal) ─────────────────────────────────────────────
AZURE_TENANT_ID=seu-tenant-id-aqui
AZURE_CLIENT_ID=seu-client-id-aqui
AZURE_CLIENT_SECRET=seu-client-secret-aqui

# ── Power BI ──────────────────────────────────────────────────────────────────
POWERBI_WORKSPACE_ID=seu-workspace-id-aqui
POWERBI_DATASET_ID=seu-dataset-id-aqui

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
EVOLUTION_API_URL=https://sua-evolution-api.easypanel.host
EVOLUTION_API_KEY=sua-api-key-aqui
EVOLUTION_INSTANCE=api_ia

# ── Destino das mensagens ─────────────────────────────────────────────────────
# Número individual: 5511999999999  |  Grupo: ID_DO_GRUPO@g.us
WHATSAPP_RECIPIENTS=5511999999999,5511888888888

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_PORT=8000
WEBHOOK_TOKEN=seu-token-aqui
# URL pública deste serviço — usada para montar links absolutos (ex.: download de Excel)
PUBLIC_BASE_URL=https://seu-agente.easypanel.host

# ── Scheduler ─────────────────────────────────────────────────────────────────
REPORT_TIMES=08:00,18:00
TIMEZONE=America/Sao_Paulo

# ── MinIO ─────────────────────────────────────────────────────────────────────
SAVE_MINIO_COPY=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=seu-access-key
MINIO_SECRET_KEY=seu-secret-key
MINIO_SECURE=false
MINIO_BUCKET=aconorte
MINIO_PREFIX=
