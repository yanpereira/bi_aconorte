# ── Azure AD (Service Principal) ─────────────────────────────────────────────
AZURE_TENANT_ID=seu-tenant-id-aqui
AZURE_CLIENT_ID=seu-client-id-aqui
AZURE_CLIENT_SECRET=seu-client-secret-aqui

# ── Power BI ──────────────────────────────────────────────────────────────────
# Workspace (group) ID — visível na URL do Power BI Service
POWERBI_WORKSPACE_ID=3302bffe-37e3-48cf-8e61-0e1eba5f63ce
# Dataset ID — visível nas propriedades do dataset no Power BI Service
POWERBI_DATASET_ID=seu-dataset-id-aqui

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-evolution-aqui
EVOLUTION_INSTANCE=aconorte

# ── Destino das mensagens ─────────────────────────────────────────────────────
# Número individual: 5511999999999  |  Grupo: ID_DO_GRUPO@g.us
WHATSAPP_RECIPIENTS=5511999999999,5511888888888

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Horários de envio no formato HH:MM (separados por vírgula)
REPORT_TIMES=08:00,18:00
TIMEZONE=America/Sao_Paulo
